PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smcms?retryWrites=true&w=majority
JWT_SECRET=replace_this_with_a_long_random_secret_string
CLIENT_URL=http://localhost:5173

# Email (Brevo). Without these, verification / password-reset emails are
# printed to the server console in development instead of being sent.
# 1. Create a free account at https://www.brevo.com (300 emails/day)
# 2. Brevo -> Senders, Domains & Dedicated IPs -> Senders: add and VERIFY EMAIL_FROM
# 3. Brevo -> SMTP & API -> API Keys: generate a key and paste it below
BREVO_API_KEY=xkeysib-replace_with_your_brevo_api_key
EMAIL_FROM=no-reply@yourcollege.edu
EMAIL_FROM_NAME=SMCMS
